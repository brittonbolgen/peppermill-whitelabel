# ---- API (apps/api) ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Demo auth signing secret. Replace before any non-demo use.
AUTH_SECRET=peppermill-demo-secret-change-me
AUTH_TOKEN_TTL_MINUTES=720

# Data layer: "json" ships with the repo. Swap to "postgres" once
# a PostgresRepository is registered in apps/api/src/repositories/index.ts
DATA_DRIVER=json

# ---- Web (apps/web) ----
# Vite reads this at build time; leave blank to use the dev proxy.
VITE_API_BASE_URL=
VITE_DEFAULT_TENANT=peppermill
